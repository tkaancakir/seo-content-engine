# Copy to .env locally. Never commit real keys. Generate runs only on the server.
GEMINI_API_KEY=
# Compatibility defaults from the original engine; choose models available to your account.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_KEYWORD_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional HTTP adapter only: choose a unique random secret of at least 32 characters.
CRON_SECRET=
